              private lateinit var acc: Account
              private var cats: List<Pair<String?, String>> = emptyList()
              private var chans: List<Channel> = emptyList()
              private lateinit var chAdapter: RowAdapter

              override fun onCreate(b: Bundle?) {
                  super.onCreate(b)
                  setContentView(R.layout.activity_browse)
                  acc = Account(intent.getStringExtra("s")!!, intent.getStringExtra("u")!!, intent.getStringExtra("p")!!)

                  chAdapter = RowAdapter(emptyList(), { i ->
                      Playlist.items = chans; Playlist.index = i
                      startActivity(Intent(this, PlayerActivity::class.java))
                  })
                  val rvCh = findViewById<RecyclerView>(R.id.rvChannels)
                  rvCh.layoutManager = LinearLayoutManager(this); rvCh.adapter = chAdapter

                  val catAdapter = RowAdapter(emptyList(), { i -> loadChannels(cats[i].first) })
                  val rvCat = findViewById<RecyclerView>(R.id.rvCats)
                  rvCat.layoutManager = LinearLayoutManager(this); rvCat.adapter = catAdapter

                  Thread {
                      try {
                          val c = listOf<Pair<String?, String>>(null to "All channels") + Xtream.categories(acc)
                          runOnUiThread { cats = c; catAdapter.items = c.map { it.second }; catAdapter.notifyDataSetChanged() }
                      } catch (e: Exception) { toast("Login/server error: ${e.message}") }
                  }.start()
              }

              private fun loadChannels(cat: String?) {
                  Thread {
                      try {
                          val l = Xtream.channels(acc, cat)
                          runOnUiThread { chans = l; chAdapter.items = l.map { it.name }; chAdapter.notifyDataSetChanged() }
                      } catch (e: Exception) { toast("Error: ${e.message}") }
                  }.start()
              }

              private fun toast(m: String) = runOnUiThread { Toast.makeText(this, m, Toast.LENGTH_LONG).show() }
          }
